# Pico production template. Copy to .env and replace every required blank.
# Production startup fails closed when a required value is absent or weak.
PICO_ENV=production
PICO_API_HOST=127.0.0.1
PICO_API_PORT=18765
PICO_DATABASE_URL=sqlite+aiosqlite:///./data/pico.db
PICO_CORS_ORIGINS=https://pico.example.com

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
PICO_ALLOWED_MODELS=kimi-k2.6,pico-agent

PICO_JWT_SECRET=
PICO_ACCEPT_TEST_ISSUER=false
PICO_ALLOW_TEST_ISSUER_BREAK_GLASS=false
# Strong internal LibreChat -> Pico credential (32+ random characters).
PICO_OPENAI_PROXY_KEY=

# Delivery tier (pico-agent). Must be ≥900 for HTML courseware; was 120 freeze.
PICO_RUN_MAX_SECONDS=900
PICO_RUN_MAX_TOKENS=32000
PICO_RUN_MAX_STEPS=24
PICO_RUN_MAX_RETRIES=2
# Short / direct-model chat
PICO_RUN_SHORT_MAX_SECONDS=120
PICO_RUN_SHORT_MAX_TOKENS=8000
# Durable (package B): long job wall + detach policy
PICO_RUN_DURABLE_MAX_SECONDS=3600
PICO_RUN_DETACH_ON_DISCONNECT=1
# KA-2 experimental path is deliberately OFF; never enable without owner authorization.
PICO_KIMI_AGENT_RUNTIME=0
# Joint keys only: school_id:membership_id (comma-separated). Empty = nobody.
# Bare membership-only values are ignored. Never commit real ids.
PICO_KIMI_AGENT_CANARY_MEMBERSHIP_IDS=
# Optional opaque batch label returned by /health (no principal ids).
PICO_KIMI_AGENT_CANARY_BATCH=
PICO_CHAT_RPM=30
PICO_CHAT_MAX_CONCURRENT=2
# Reject overlong prompts (no silent truncate). Default 12000.
PICO_CHAT_MAX_PROMPT_CHARS=12000
PICO_DANGEROUS_TOOLS_ENABLED=false

ALLOW_REGISTRATION=false
PICO_DEMO_SEED=0
PICO_DEMO_EMAIL=
PICO_DEMO_PASSWORD=

# Required by docker-compose.* for LibreChat. Generate independent random values.
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=

# Pico production template. Copy to .env and replace every required blank.
# Production startup fails closed when a required value is absent or weak.
PICO_ENV=production
PICO_API_HOST=127.0.0.1
PICO_API_PORT=18765
PICO_DATABASE_URL=sqlite+aiosqlite:///./data/pico.db
PICO_CORS_ORIGINS=https://pico.example.com

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
PICO_ALLOWED_MODELS=kimi-k2.6,pico-agent

PICO_JWT_SECRET=
PICO_ACCEPT_TEST_ISSUER=false
PICO_ALLOW_TEST_ISSUER_BREAK_GLASS=false
# Strong internal LibreChat -> Pico credential (32+ random characters).
PICO_OPENAI_PROXY_KEY=

PICO_RUN_MAX_SECONDS=120
PICO_RUN_MAX_TOKENS=8000
PICO_RUN_MAX_RETRIES=2
PICO_CHAT_RPM=30
PICO_CHAT_MAX_CONCURRENT=2
PICO_DANGEROUS_TOOLS_ENABLED=false

ALLOW_REGISTRATION=false
PICO_DEMO_SEED=0
PICO_DEMO_EMAIL=
PICO_DEMO_PASSWORD=

# Required by docker-compose.* for LibreChat. Generate independent random values.
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=

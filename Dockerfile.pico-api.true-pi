# Pico API image with true-Pi RPC binary (production multi-step default).
# Pin: @earendil-works/pi-coding-agent@0.84.4 (ADR-PI-TRUE-KERNEL-RPC · #806)
#
# CN-friendly build (Aliyun apt/pypi + npmmirror Node binary).
# Avoid nodesource + deb.debian.org-only paths that stall on light VPS.
#
# Lean-only image (no Node/pi): Dockerfile.pico-api — not for public DEFAULT=1.
#
# Cache law (BINDING):
# - Pin FROM digest. Floating python:3.12-slim retags bust every pip layer.
# - Never ARG/ENV a per-deploy SHA. Runtime SHA is compose `.env` only.
# - Never install the `docling` meta-package. Lock ingest + constraints-no-torch.

FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

WORKDIR /app
ARG NODE_VERSION=22.22.0
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PATH="/usr/local/lib/nodejs/bin:${PATH}"

# Node 22 + pinned pi CLI
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
      sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
      sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list; \
      sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl xz-utils; \
    curl -fsSL \
      "https://npmmirror.com/mirrors/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      -o /tmp/node.tar.xz; \
    mkdir -p /usr/local/lib/nodejs; \
    tar -xJf /tmp/node.tar.xz -C /usr/local/lib/nodejs --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    npm config set registry https://registry.npmmirror.com; \
    npm install -g @earendil-works/pi-coding-agent@0.84.4; \
    pi --version; \
    apt-get purge -y xz-utils; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*

RUN pip install -i https://mirrors.aliyun.com/pypi/simple/ pip==26.2.1

COPY requirements.txt constraints-no-torch.txt requirements-ingest.txt /app/
RUN pip install -i https://mirrors.aliyun.com/pypi/simple/ \
      -c /app/constraints-no-torch.txt \
      -r /app/requirements.txt

# T-PICO-NO-TORCH: lock office extras. constraints-no-torch fails closed
# instead of downloading CUDA if a future extra starts requiring torch.
RUN pip install -i https://mirrors.aliyun.com/pypi/simple/ \
      -c /app/constraints-no-torch.txt \
      -r /app/requirements-ingest.txt \
 && python -c "import importlib.util,sys; sys.exit(1 if importlib.util.find_spec('torch') else 0)"

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      libglib2.0-0 libgomp1 libgl1 libxcb1 libsm6 libxext6 libxrender1; \
    rm -rf /var/lib/apt/lists/*

COPY services /app/services
COPY packages /app/packages
COPY pyproject.toml /app/pyproject.toml

ENV DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    HF_HOME=/opt/docling-models/hf \
    HUGGINGFACE_HUB_CACHE=/opt/docling-models/hf \
    HF_ENDPOINT=https://hf-mirror.com \
    HF_HUB_DISABLE_XET=1 \
    HF_HUB_ENABLE_HF_TRANSFER=0 \
    HF_HUB_DISABLE_TELEMETRY=1

# RapidOCR ONNX paths only. No HF layout / TableFormer / torch.
RUN python /app/packages/field-kb-ingest/prefetch_models.py

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

RUN mkdir -p /app/data /tmp/pico-true-pi-sessions

EXPOSE 18765
CMD ["uvicorn", "app.main:app", "--app-dir", "services/api", "--host", "127.0.0.1", "--port", "18765"]

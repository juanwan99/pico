{
  "id": "R15",
  "title": "网页查资料带出处",
  "timeout_s": 600,
  "turns": [
    {
      "prompt": "查一下国家对中小学劳动教育课每周课时有什么要求，告诉我结论并附上出处链接。"
    }
  ],
  "checks": [
    {
      "type": "reply_regex",
      "pattern": "每周[^。\\n]{0,12}(1|一)\\s*课时"
    },
    {
      "type": "reply_links_min",
      "n": 1
    }
  ],
  "how": "答出「每周不少于 1 课时」，至少 1 个 http 出处"
}

# Pico Phase 1 — copy to .env (never commit real keys)

# --- Model provider (S1) ---
# Kimi / Moonshot API — required for S1 PASS. Without key: S1 stays BLOCKED.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
# Optional fallback (still real API; not mock)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Auth (S4) test issuer ---
PICO_JWT_SECRET=change-me-dev-only-not-for-prod-32b!
PICO_JWT_ISS=pico-test-issuer
PICO_JWT_AUD=pico-api
PICO_JWT_TTL_SECONDS=900

# --- Spend caps (D1 freeze) ---
PICO_RUN_MAX_SECONDS=120
PICO_RUN_MAX_TOKENS=8000
PICO_RUN_MAX_RETRIES=2

# --- API ---
PICO_API_HOST=0.0.0.0
PICO_API_PORT=8000
PICO_DATABASE_URL=sqlite+aiosqlite:///./data/pico.db
PICO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Agent safety (must stay true) ---
PICO_AGENT_FILE=services/orchestrator/agents/pico.yaml
PICO_DANGEROUS_TOOLS_ENABLED=false

# --- Phase 3 edu integration ---
# fake (default) | live
PICO_EDU_MODE=fake
PICO_EDU_BASE_URL=
PICO_EDU_SERVICE_TOKEN=
PICO_EDU_TIMEOUT_SECONDS=10
PICO_EDU_HANDOFF_ENABLED=false

# edu-issued tokens (claim shape same as test issuer)
PICO_EDU_ISS=
PICO_EDU_JWT_SECRET=
# PICO_EDU_JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
PICO_ACCEPT_TEST_ISSUER=true

# edu → Pico hooks
PICO_HOOK_SERVICE_TOKEN=

# Pico Phase 1 — copy to .env (never commit real keys)

# --- Model provider (S1) ---
# Product default brain = DeepSeek. Get key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# Prefer deepseek when both keys present (kimi = legacy fallback)
PICO_MODEL_PROVIDER=deepseek
# Optional Kimi / Moonshot fallback
KIMI_API_KEY=
# MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# --- Auth (S4) test issuer ---
PICO_JWT_SECRET=change-me-dev-only-not-for-prod-32b!
PICO_JWT_ISS=pico-test-issuer
PICO_JWT_AUD=pico-api
PICO_JWT_TTL_SECONDS=900

# --- Tiered run budgets (P-COMPLEX-DONE) ---
# Delivery / pico-agent (课件等): wall clock + steps + tokens. Default 900s ≈ 15min.
# Do NOT set a multi-hour single cap here to fake long jobs (that is package B).
PICO_RUN_MAX_SECONDS=900
PICO_RUN_MAX_TOKENS=32000
PICO_RUN_MAX_STEPS=24
PICO_RUN_MAX_RETRIES=2
# Short / direct-model chat: keep day-use turns snappy.
PICO_RUN_SHORT_MAX_SECONDS=120
PICO_RUN_SHORT_MAX_TOKENS=8000
# Durable long jobs (package B). Wall cap for staged jobs; must pair with detach.
# Do NOT set 28800 alone and call that "durable" — see docs/ADR-DURABLE-RUN.md.
PICO_RUN_DURABLE_MAX_SECONDS=3600
# Page close / SSE abort: 1 = job continues (default). 0 = legacy kill-on-disconnect.
PICO_RUN_DETACH_ON_DISCONNECT=1
# Pi Agent multi-step path (product default · HANDOFF-WB-PI). 1 + empty canary = ALL.
PICO_PI_AGENT_RUNTIME=1
# Joint canary keys: school_id:membership_id. Empty + RUNTIME=1 = ALL. * / *:* = ALL.
PICO_PI_AGENT_CANARY_MEMBERSHIP_IDS=
# P2 MCP allowlist bridge (safe tools). Empty = MCP tools off.
PICO_MCP_ALLOWLIST=mcp_time,mcp_workspace_stat

PICO_PI_AGENT_CANARY_BATCH=
# Legacy Kimi Agent multi-step (rollback only; off by default). Pi wins if both on.
PICO_LEGACY_KIMI_AGENT_RUNTIME=0
# Alias still accepted:
PICO_KIMI_AGENT_RUNTIME=0
PICO_KIMI_AGENT_CANARY_MEMBERSHIP_IDS=
PICO_KIMI_AGENT_CANARY_BATCH=
# DEPRECATED no-op (KA-4 HARD). Kept for compatibility; does not restore loop.
PICO_LEGACY_AGENT_LOOP_EMERGENCY=0
PICO_CHAT_RPM=30
PICO_CHAT_MAX_CONCURRENT=2
# Reject overlong prompts (no silent truncate). Default 12000.
PICO_CHAT_MAX_PROMPT_CHARS=12000
# Required in production; only these request model IDs are accepted.
# First entry = LibreChat default for a new conversation; UI exposes only Pico 快速 / Pico 深度.
PICO_ALLOWED_MODELS=pico-fast,pico-deep

# --- API ---
PICO_API_HOST=127.0.0.1
PICO_API_PORT=18765
PICO_DATABASE_URL=sqlite+aiosqlite:///./data/pico.db
PICO_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3080,http://127.0.0.1:3080

# --- Agent safety (must stay true) ---
PICO_AGENT_FILE=services/orchestrator/agents/pico.yaml
PICO_DANGEROUS_TOOLS_ENABLED=false

# --- Phase 3 edu integration ---
PICO_EDU_MODE=fake
PICO_EDU_BASE_URL=
PICO_EDU_SERVICE_TOKEN=
PICO_EDU_TIMEOUT_SECONDS=10
PICO_EDU_HANDOFF_ENABLED=false
PICO_EDU_ISS=
PICO_EDU_JWT_SECRET=
# Optional preferred production verification key (RS256 public PEM).
PICO_EDU_JWT_PUBLIC_KEY_PEM=
# true = test + configured edu issuer; false = configured edu issuer only.
PICO_ACCEPT_TEST_ISSUER=true
PICO_ALLOW_TEST_ISSUER_BREAK_GLASS=false
PICO_HOOK_SERVICE_TOKEN=
# Host .env only. prod-update.sh generates if empty. Shared with edu-core pull.
# Never commit the value. Empty → GET /v1/internal/usage/export returns 503.

# --- Knowledge (Meilisearch projection · loopback only) ---
# Host-only. Never commit the real key. prod-update.sh generates if missing.
PICO_MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=
# Optional: Meili hybrid embedder only (NOT image gen — SiliconFlow images REJECTED).
# SILICONFLOW_API_KEY=
# Image gen (host .env / secrets only; never commit).
# Intended: owner New API reverse-proxies many Gemini API keys (渠道组).
# Pico calls ONE New API URL. Optional extra New API tokens (not Google keys)
# fail over on 429. No Google poller. No in-process Google key farm.
# PICO_IMAGE_GATEWAY_URL=   # e.g. http://127.0.0.1:3000  or https://newapi.example.com
# PICO_IMAGE_GATEWAY_KEY=   # New API token, not a Gemini key
# PICO_IMAGE_GATEWAY_KEYS=  # optional extra New API tokens, comma-separated
# PICO_IMAGE_GATEWAY_MODEL=gemini-2.5-flash-image
# PICO_IMAGE_KEY_MIN_INTERVAL_S=2
# gemini-*-image → New API generateContent; imagen-* → /v1/images/generations
# Optional leftover (not the #752 design): direct Gemini or Zhipu if gateway unset.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# ZHIPU_API_KEY=
# ZHIPU_IMAGES_URL=   # default https://open.bigmodel.cn/api/paas/v4/images/generations
# ZHIPU_IMAGE_MODEL=glm-image

# --- OpenAI-compat (LibreChat shell) ---
# Dev-only proxy Bearer for LibreChat OPENAI_API_KEY. Production: JWT only.
PICO_OPENAI_PROXY_KEY=pico-dev
PICO_ENV=development

# Production keeps registration and fixed-password demo seeding off by default.
PICO_DEMO_SEED=0
ALLOW_REGISTRATION=false

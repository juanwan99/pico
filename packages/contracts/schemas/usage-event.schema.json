{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pico.local/schemas/usage-event.schema.json",
  "title": "PicoUsageEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "school_id",
    "membership_id",
    "kind",
    "tokens_unknown",
    "estimated",
    "billing",
    "schema"
  ],
  "properties": {
    "id": { "type": "string" },
    "school_id": { "type": "string" },
    "membership_id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["llm", "search", "sandbox", "image", "api", "other"]
    },
    "model": { "type": ["string", "null"] },
    "prompt_tokens": { "type": ["integer", "null"] },
    "completion_tokens": { "type": ["integer", "null"] },
    "total_tokens": { "type": ["integer", "null"] },
    "tokens_unknown": { "type": "boolean" },
    "estimated": { "type": "boolean" },
    "task_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "source": { "type": "string" },
    "extra": { "type": "object" },
    "created_at": { "type": ["string", "null"] },
    "billing": { "type": "boolean", "const": false },
    "schema": { "type": "string", "const": "pico.usage.v1" }
  }
}

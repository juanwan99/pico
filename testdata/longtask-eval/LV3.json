{
  "id": "LV3",
  "title": "成绩数据画图写分析（Word）",
  "timeout_s": 900,
  "turns": [
    {
      "prompt": "附件是一个班的期中成绩。请做一份成绩分析（Word）：先放一张各小组三科平均分的分组柱状图，再放一张数学分数段（60 以下、60-69、70-79、80-89、90 以上）人数图；两张图都要有中文标题、坐标轴名称和图例；每张图下面写两三句结论，数字要和数据一致。",
      "attachments": [
        {
          "name": "期中成绩.csv",
          "file": "fixtures/class-scores.csv"
        }
      ]
    }
  ],
  "expect": {
    "kinds": [
      "docx"
    ],
    "min_paragraphs": 4
  },
  "score_points": [
    {
      "id": "p1",
      "text": "两张图都在、中文正常"
    },
    {
      "id": "p2",
      "text": "图与结论数字一致"
    },
    {
      "id": "p3",
      "text": "坐标轴、图例齐全"
    }
  ]
}

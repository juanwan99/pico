# pico#1270 · user unit on the ECS host: install with
#   cp deploy/systemd/pico-backup*.service deploy/systemd/pico-backup*.timer ~/.config/systemd/user/ && systemctl --user daemon-reload \
#   && systemctl --user enable --now pico-backup.timer pico-backup-watch.timer pico-backup-drill.timer
[Unit]
Description=pico daily backup to Google Drive (gdrive:pico-backup)

[Service]
Type=oneshot
Environment=PICO_BACKUP_REMOTE=gdrive:pico-backup
Environment=PICO_BACKUP_PROXY=http://127.0.0.1:7893
Environment=PICO_BACKUP_KEEP_DAYS=15
ExecStart=/bin/bash /opt/pico/scripts/backup-pico.sh run
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
